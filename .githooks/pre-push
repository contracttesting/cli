#!/bin/sh
set -e
export GOWORK=off

unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "gofmt: unformatted files:" >&2
  echo "$unformatted" >&2
  exit 1
fi
go vet ./...
go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.13.2 run ./...
go test ./...
go run golang.org/x/vuln/cmd/govulncheck@latest ./...
